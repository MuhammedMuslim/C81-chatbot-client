# Optional: absolute API base for production builds (no nginx proxy). Docker / Helm leave this empty
# so the browser uses same-origin /api and nginx proxies to Spring Boot (BACKEND_HOST / BACKEND_PORT on the container).
# Helm: see ../helm/values.example.yaml
# REACT_APP_API_BASE_URL=http://localhost:8080

# Local dev: create-react-app proxies /api to Spring (see package.json "proxy" → 8080).
# Start Spring Boot from ../backent-chatbot on port 8080, then: npm start
